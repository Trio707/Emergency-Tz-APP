# Emergency Tanzania - Local Properties Template
# Copy this file to local.properties and fill in your values
# DO NOT COMMIT local.properties to version control!

# Debug test phone number for Android
# Set this to a phone number you own to test calling in debug builds
# Release builds always use the real emergency numbers (112, 114, 115)
# DEBUG_TEST_PHONE_NUMBER=+255XXXXXXXXX

# Android signing configuration (for release builds)
# Set these via environment variables or GitHub Secrets in CI
# KEYSTORE_PATH=path/to/keystore.jks
# KEYSTORE_PASSWORD=your_keystore_password
# KEY_ALIAS=your_key_alias
# KEY_PASSWORD=your_key_password

# iOS signing (configured in Xcode)
# DEVELOPMENT_TEAM=YOUR_TEAM_ID
# PROVISIONING_PROFILE_SPECIFIER=Your Profile Name