# Normalize line endings on checkout, store LF in the repository.
* text=auto eol=lf

# Shell scripts must keep LF endings or they fail to execute on Unix/macOS.
*.sh text eol=lf
gradlew text eol=lf

# gradlew.bat is a Windows batch file and requires CRLF.
gradlew.bat text eol=crlf

# Binary files that must never be line-ending converted.
*.jar binary
*.apk binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.so binary
*.aar binary

# Gradle / Kotlin / Android sources.
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.pro text eol=lf

# Documentation.
*.md text eol=lf
*.txt text eol=lf
